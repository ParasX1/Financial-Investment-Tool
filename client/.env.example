# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Optional Flask API override. Local development defaults to this URL.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# Server-only market news provider settings.
# Google News RSS is primary; Yahoo Finance RSS is the default auxiliary source.
# GDELT remains available as an explicit opt-in provider.
# Reorder or remove IDs here without changing the news service.
NEWS_PROVIDER_ORDER=google-rss,yahoo-rss
NEWS_PROVIDER_TIMEOUT_MS=5000
GDELT_NEWS_ENABLED=false
GDELT_NEWS_TIMESPAN=7d
GOOGLE_NEWS_RSS_ENABLED=true
YAHOO_FINANCE_RSS_ENABLED=true
YAHOO_FINANCE_RSS_URL=https://finance.yahoo.com/news/rssindex
