# Server-only market news providers. Prefer MarketAux for production finance news.
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Optional fallback provider, also server-only. NewsAPI's free plan is development-only.
NEWSAPI_KEY=your_newsapi_key_here

# Provider order is server-only. GDELT is the no-key free news index.
# Google News RSS and Yahoo RSS are development fallbacks; disable them before
# production unless product/legal review approves the exact use.
NEWS_PROVIDER_ORDER=marketaux,gdelt,newsapi,google-rss,yahoo-rss
GDELT_NEWS_ENABLED=true
GDELT_NEWS_TIMESPAN=1week
GOOGLE_NEWS_RSS_ENABLED=true
YAHOO_FINANCE_RSS_ENABLED=true
YAHOO_FINANCE_RSS_URL=https://finance.yahoo.com/news/rssindex
