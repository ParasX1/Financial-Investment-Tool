# Flask-only Supabase configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_publishable_key
# Optional: only the explicitly requested sync:top-picks write command needs it.
# Keep this backend-only credential out of client/.env.local and NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Root npm run dev / sync:top-picks: process environment overrides this file.
# Optional Python executable; defaults to python from the active environment.
# FINANCE_DEV_SERVER_PYTHON=/path/to/server/.venv/bin/python
# Development startup never syncs the universe. TOP_PICKS_DEV_SYNC_* is ignored.
# Default cache location is server/.cache, independent of the startup directory.
# For a custom location, use an absolute path so both launch methods agree.
# TOP_PICKS_CACHE_PATH=/absolute/path/top-picks-snapshot-cache.json
# Optional history path; defaults to TOP_PICKS_CACHE_PATH + .history.sqlite3.
# Set TOP_PICKS_HISTORY_PATH to an empty value for in-memory history only.
