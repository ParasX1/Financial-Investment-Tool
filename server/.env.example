# Backend-only Supabase configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_publishable_key
# Optional: background and explicit universe sync prefer this write credential.
# Keep this backend-only credential out of client/.env.local and NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Root startup / sync:top-picks: process environment overrides this file.
# Optional Python executable; ordinary startup defaults to the active python.
# With --with-universe-sync, discovers financeDev-server before falling back to python.
# FINANCE_DEV_SERVER_PYTHON=/path/to/server/.venv/bin/python
# npm run dev / dev:all start services only, without universe sync.
# dev:env / dev:env:mac select --with-universe-sync (ASX200 after 60s, SP500 after 90s).
# Only in that mode, TOP_PICKS_DEV_SYNC_ASX200=false / TOP_PICKS_DEV_SYNC_SP500=false disable jobs;
# TOP_PICKS_DEV_SYNC_DELAY_MS / TOP_PICKS_DEV_SYNC_SP500_DELAY_MS set their delays.
# Default cache location is server/.cache, independent of the startup directory.
# For a custom location, use an absolute path so both launch methods agree.
# TOP_PICKS_CACHE_PATH=/absolute/path/top-picks-snapshot-cache.json
# Optional history path; defaults to TOP_PICKS_CACHE_PATH + .history.sqlite3.
# Set TOP_PICKS_HISTORY_PATH to an empty value for in-memory history only.
